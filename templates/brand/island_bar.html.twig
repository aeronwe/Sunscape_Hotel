{% extends 'base.html.twig' %}

{% block title %}The Island Bar | Ejercito's Sunscape Resort{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/pages/island-bar.css') }}">
{% endblock %}

{% block body_class %}inner-page{% endblock %}

{% block body %}
<main>
    <!-- Breadcrumb -->
    <div class="rd-breadcrumb-bar">
        <div class="container">
            <p class="booking-breadcrumb">
                <a href="{{ path('home') }}">Home</a> &gt; <a href="{{ path('dining_index') }}">Dining &amp; Cuisine</a> &gt; The Island Bar
            </p>
        </div>
    </div>

    <!-- Venue Navigation Tabs -->
    <section style="padding: 16px 0 0;">
        <div class="container">
            <div class="dd-venue-tabs" role="tablist" aria-label="Dining Venues">
                <a href="{{ path('el_juwan') }}" class="dd-venue-tab">El Juwan Restaurant</a>
                <a href="{{ path('island_bar') }}" class="dd-venue-tab active">The Island Bar</a>
                <a href="{{ path('beach_bbq') }}" class="dd-venue-tab">Coast Grill Nights</a>
            </div>
        </div>
    </section>

    <!-- Image Gallery -->
