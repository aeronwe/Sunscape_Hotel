                            <span>Gentle Island Music</span>
                        </div>
                    </div>

                    <!-- Popular Menu -->
                    <h2 class="rd-section-heading">Featured Drinks &amp; Bites</h2>
                    <div class="dd-menu-grid">
                        <div class="dd-menu-item">
                            <div class="dd-menu-header">
                                <span class="dd-menu-title">Siquijor Sunset Cocktail</span>
                                <span class="dd-menu-price">₱320</span>
                            </div>
                            <p class="dd-menu-desc">Dark rum mixed with fresh mango juice, grenadine, and lime.</p>
                        </div>
                        <div class="dd-menu-item">
                            <div class="dd-menu-header">
                                <span class="dd-menu-title">Sunscape Classic Mojito</span>
                                <span class="dd-menu-price">₱290</span>
                            </div>
                            <p class="dd-menu-desc">White rum, fresh garden mint, calamansi, and chilled soda water.</p>
                        </div>
                        <div class="dd-menu-item">
                            <div class="dd-menu-header">
                                <span class="dd-menu-title">Crispy Calamari Basket</span>
                                <span class="dd-menu-price">₱360</span>
                            </div>
                            <p class="dd-menu-desc">Golden fried squid rings served with lemon garlic dip.</p>
                        </div>
                        <div class="dd-menu-item">
                            <div class="dd-menu-header">
                                <span class="dd-menu-title">Loaded Beach Nachos</span>
                                <span class="dd-menu-price">₱380</span>
                            </div>
