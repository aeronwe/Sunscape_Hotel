                            <span>Free Wi-Fi</span>
                        </div>
                        <div class="rd-amenity">
                            <span class="rd-amenity-icon"><svg xmlns="http://www.w3.org/2000/svg" height="20" viewBox="0 -960 960 960" width="20" fill="currentColor"><path d="M80-146v-78q29 0 49.5-9t41.5-19.5q21-10.5 46.5-19T280-280q38 0 62.5 8.5t45.5 19q21 10.5 42 19.5t50 9q29 0 50-9t42-19.5q21-10.5 46-19t62-8.5q38 0 63 8.5t46 19q21 10.5 42 19.5t49 9v78q-38 0-63.5-9T770-174.5q-21-10.5-41-19t-49-8.5q-28 0-48.5 8.5t-41 19Q570-164 544.5-155t-64.5 9q-39 0-64.5-9t-46-19.5Q349-185 329-193.5t-49-8.5q-28 0-48.5 8.5t-41.5 19Q169-164 143.5-155T80-146Z"/></svg></span>
                            <span>Ocean Breeze Seating</span>
                        </div>
                    </div>

                    <!-- Popular Menu -->
                    <h2 class="rd-section-heading">Popular Grilled Dishes</h2>
                    <div class="dd-menu-grid">
                        <div class="dd-menu-item">
                            <div class="dd-menu-header">
                                <span class="dd-menu-title">Whole Charcoal Red Snapper</span>
                                <span class="dd-menu-price">₱750</span>
                            </div>
                            <p class="dd-menu-desc">Whole fresh catch grilled over charcoal with lemongrass and sea salt.</p>
                        </div>
                        <div class="dd-menu-item">
                            <div class="dd-menu-header">
                                <span class="dd-menu-title">Pork BBQ Skewers (4 sticks)</span>
                                <span class="dd-menu-price">₱340</span>
                            </div>
                            <p class="dd-menu-desc">Tender pork skewers glazed with sweet savory Filipino barbecue sauce.</p>
                        </div>
                        <div class="dd-menu-item">
                            <div class="dd-menu-header">
                                <span class="dd-menu-title">Inihaw na Pusit</span>
                                <span class="dd-menu-price">₱480</span>
                            </div>
                            <p class="dd-menu-desc">Fresh whole squid stuffed with diced tomatoes and onions, charcoal grilled.</p>
                        </div>
                        <div class="dd-menu-item">
                            <div class="dd-menu-header">
                                <span class="dd-menu-title">Grilled Tiger Prawns</span>
                                <span class="dd-menu-price">₱680</span>
                            </div>
                            <p class="dd-menu-desc">Plump ocean prawns brushed with garlic butter and grilled to perfection.</p>
                        </div>
                        <div class="dd-menu-item">
                            <div class="dd-menu-header">
                                <span class="dd-menu-title">Chicken Inasal Quarter</span>
                                <span class="dd-menu-price">₱420</span>
                            </div>
                            <p class="dd-menu-desc">Chicken marinated in calamansi, ginger, and annatto oil, flame grilled.</p>
                        </div>
                        <div class="dd-menu-item">
                            <div class="dd-menu-header">
                                <span class="dd-menu-title">Grilled Sweet Corn and Rice</span>
                                <span class="dd-menu-price">₱160</span>
                            </div>
                            <p class="dd-menu-desc">Charred sweet corn on the cob served with warm fragrant garlic rice.</p>
                        </div>
                    </div>

