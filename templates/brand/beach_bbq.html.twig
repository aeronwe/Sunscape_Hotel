{% extends 'base.html.twig' %}

{% block title %}Coast Grill Nights | Ejercito's Sunscape Resort{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/pages/beach-bbq.css') }}">
{% endblock %}

{% block body_class %}inner-page{% endblock %}

{% block body %}
<main>
    <!-- Breadcrumb -->
    <div class="rd-breadcrumb-bar">
        <div class="container">
            <p class="booking-breadcrumb">
                <a href="{{ path('home') }}">Home</a> &gt; <a href="{{ path('dining_index') }}">Dining &amp; Cuisine</a> &gt; Coast Grill Nights
            </p>
        </div>
    </div>

    <!-- Venue Navigation Tabs -->
    <section style="padding: 16px 0 0;">
        <div class="container">
            <div class="dd-venue-tabs" role="tablist" aria-label="Dining Venues">
                <a href="{{ path('el_juwan') }}" class="dd-venue-tab">El Juwan Restaurant</a>
                <a href="{{ path('island_bar') }}" class="dd-venue-tab">The Island Bar</a>
                <a href="{{ path('beach_bbq') }}" class="dd-venue-tab active">Coast Grill Nights</a>
            </div>
        </div>
    </section>

    <!-- Image Gallery -->
    <section class="rd-gallery-section" style="padding-top: 0;">
        <div class="container">
            <div class="rd-gallery">
                <div class="rd-gallery-main">
                    <img src="{{ asset('images/Beach-BBQ-9.jpg') }}" alt="Coast Grill Nights - Main View" id="rdMainImage">
                </div>
                <div class="rd-gallery-thumbs">
                    <div class="rd-thumb rd-thumb-active" onclick="changeMainImage('{{ asset('images/Beach-BBQ-9.jpg') }}', this)">
                        <img src="{{ asset('images/Beach-BBQ-9.jpg') }}" alt="Coast Grill Nights View 1" loading="lazy">
                    </div>
                    <div class="rd-thumb" onclick="changeMainImage('https://images.unsplash.com/photo-1544025162-d76694265947?auto=format&amp;fit=crop&amp;w=1000&amp;q=80', this)">
                        <img src="https://images.unsplash.com/photo-1544025162-d76694265947?auto=format&amp;fit=crop&amp;w=1000&amp;q=80" alt="Coast Grill Nights View 2" loading="lazy">
                    </div>
                    <div class="rd-thumb" onclick="changeMainImage('https://images.unsplash.com/photo-1555939594-58d7cb561ad1?auto=format&amp;fit=crop&amp;w=1000&amp;q=80', this)">
                        <img src="https://images.unsplash.com/photo-1555939594-58d7cb561ad1?auto=format&amp;fit=crop&amp;w=1000&amp;q=80" alt="Coast Grill Nights View 3" loading="lazy">
                    </div>
                    <div class="rd-thumb" onclick="changeMainImage('https://images.unsplash.com/photo-1529193591184-b1d58069ecdd?auto=format&amp;fit=crop&amp;w=1000&amp;q=80', this)">
                        <img src="https://images.unsplash.com/photo-1529193591184-b1d58069ecdd?auto=format&amp;fit=crop&amp;w=1000&amp;q=80" alt="Coast Grill Nights View 4" loading="lazy">
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Venue Details Content -->
    <section class="rd-content-section">
        <div class="container">
            <div class="rd-layout">
                <!-- Left Column -->
                <div class="rd-info-column">
