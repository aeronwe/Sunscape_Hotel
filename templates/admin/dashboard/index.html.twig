{% extends 'admin/base.html.twig' %}

{% block title %}Dashboard | Admin Panel{% endblock %}
{% block topbar_title %}Admin Dashboard{% endblock %}

{% block content %}
<!-- System Overview (Rubric Metrics: Total Users, Total Staff, Total Records) -->
<div class="stats-grid" style="margin-bottom: 20px;">
    <div class="stat-card">
        <div class="stat-info">
            <div class="stat-label">Total Users (Guests)</div>
            <div class="stat-value">{{ stats.total_users }}</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-info">
            <div class="stat-label">Total Staff &amp; Admins</div>
            <div class="stat-value">{{ stats.total_staff }}</div>
            <small style="color: var(--admin-text-dim); font-size: 0.75rem;">{{ stats.admin_count }} Admin · {{ stats.staff_only_count }} Staff</small>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-info">
            <div class="stat-label">Total Records</div>
            <div class="stat-value">{{ stats.total_records }}</div>
            <small style="color: var(--admin-text-dim); font-size: 0.75rem;">Rooms, Services &amp; Bookings</small>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-info">
            <div class="stat-label">Confirmed Revenue</div>
            <div class="stat-value">₱{{ stats.total_revenue|number_format(0, '.', ',') }}</div>
        </div>
    </div>
</div>

<!-- Resort Breakdown Stats -->
<div class="stats-grid" style="margin-bottom: 36px;">
    <div class="stat-card">
        <div class="stat-info">
            <div class="stat-label">Total Rooms</div>
            <div class="stat-value">{{ stats.total_rooms }}</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-info">
            <div class="stat-label">Services &amp; Experiences</div>
            <div class="stat-value">{{ stats.total_services }}</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-info">
            <div class="stat-label">Total Reservations</div>
            <div class="stat-value">{{ stats.total_reservations }}</div>
        </div>
    </div>
    <div class="stat-card">
        <div class="stat-info">
            <div class="stat-label">Pending / Today Check-ins</div>
            <div class="stat-value">{{ stats.pending_reservations }} / {{ stats.today_checkins }}</div>
        </div>
    </div>
</div>

<!-- Recent Reservations -->
<div class="admin-panel">
    <div class="panel-header">
        <h2 class="panel-title">Recent Reservations</h2>
        <div style="display:flex; gap:8px;">
            <a href="{{ path('admin_staff') }}" class="admin-btn admin-btn-gold">Manage Staff &rarr;</a>
            <a href="{{ path('admin_reservations') }}" class="admin-btn admin-btn-outline">View All Reservations &rarr;</a>
        </div>
    </div>
    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Guest</th>
                    <th>Room</th>
                    <th>Check-in</th>
                    <th>Check-out</th>
                    <th>Amount</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                {% if recentReservations is empty %}
                    <tr><td colspan="7" style="text-align:center; padding: 40px; color: var(--admin-text-dim);">No reservations yet</td></tr>
                {% else %}
                    {% for res in recentReservations %}
                        <tr>
                            <td class="td-primary">#{{ res.id }}</td>
                            <td class="td-primary">{{ res.fullName }}</td>
                            <td>{{ res.roomType }}</td>
                            <td>{{ res.checkinDate ? res.checkinDate|date('M d, Y') : '' }}</td>
                            <td>{{ res.checkoutDate ? res.checkoutDate|date('M d, Y') : '' }}</td>
                            <td>₱{{ res.totalAmount|number_format(0, '.', ',') }}</td>
                            <td><span class="status-badge status-{{ res.status }}">{{ res.status }}</span></td>
                        </tr>
                    {% endfor %}
                {% endif %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
