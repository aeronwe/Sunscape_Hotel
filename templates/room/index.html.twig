{% extends 'base.html.twig' %}
{% block title %}Rooms &amp; Suites | Ejercito's Sunscape Resort{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/pages/rooms.css') }}">
{% endblock %}

{% block body %}
<main>
    <section class="inner-hero rooms-hero">
        <p class="section-label">Stay With Us</p>
        <h1>Rooms &amp; Suites</h1>
        <p>Thoughtfully designed spaces where island comfort meets effortless style.</p>
    </section>
    <section class="rooms-page-section">
        <div class="container">
            <form class="room-filters" method="get">
                <label><span>Room type</span><select name="type"><option value="all">All rooms</option>{% for value in ['standard','deluxe','suite','villa','premium'] %}<option value="{{ value }}" {% if type == value %}selected{% endif %}>{{ value|title }}</option>{% endfor %}</select></label>
                <label><span>Price range</span><select name="price"><option value="all">Any price</option><option value="under-5000" {% if price == 'under-5000' %}selected{% endif %}>Under ₱5,000</option><option value="5000-10000" {% if price == '5000-10000' %}selected{% endif %}>₱5,000–₱10,000</option><option value="over-10000" {% if price == 'over-10000' %}selected{% endif %}>Over ₱10,000</option></select></label>
                <label><span>Guests</span><select name="guests"><option value="all">Any capacity</option><option value="1-2" {% if guests == '1-2' %}selected{% endif %}>1–2 guests</option><option value="3-4" {% if guests == '3-4' %}selected{% endif %}>3–4 guests</option><option value="5-plus" {% if guests == '5-plus' %}selected{% endif %}>5+ guests</option></select></label>
                <label><span>Sort by</span><select name="sort"><option value="featured">Featured</option><option value="price-low" {% if sort == 'price-low' %}selected{% endif %}>Price: low to high</option><option value="price-high" {% if sort == 'price-high' %}selected{% endif %}>Price: high to low</option><option value="name" {% if sort == 'name' %}selected{% endif %}>Name</option></select></label>
            </form>
            <div class="rooms-grid">
                {% for room in roomList %}
                    <article class="room-card">
                        <div class="room-image-wrapper"><span class="room-badge {{ room.badge_class }}">{{ room.badge }}</span><img class="room-image" src="{{ room.image }}" alt="{{ room.name }}" loading="lazy"></div>
                        <div class="room-info"><h3 class="room-name">{{ room.name }}</h3><p class="room-specs">{{ room.specs }}</p><div class="room-card-bottom"><p class="room-price">₱{{ room.price|number_format(0) }} <span>/ night</span></p><a href="{{ path('room_detail', {slug: room.slug}) }}" class="btn-room-detail">Details</a></div></div>
                    </article>
                {% else %}<p>No rooms match your selected filters.</p>{% endfor %}
            </div>
        </div>
    </section>
</main>
{% endblock %}
