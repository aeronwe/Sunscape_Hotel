<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="{% block meta_description %}Ejercito's Sunscape Resort — Siquijor's Premier Beachfront Resort. Tropical retreat in Siquijor, Philippines offering luxury rooms, fine dining, and island experiences.{% endblock %}">
    <title>{% block title %}Ejercito's Sunscape Resort | Where The Sun Meets The Shore{% endblock %}</title>

    {# Google Fonts #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700;800;900&family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    {% block stylesheets %}{% endblock %}

    {% block javascripts %}
        {# AssetMapper: injects importmap + loads assets/app.js (which imports assets/styles/app.css) #}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body class="{% block body_class %}{% endblock %}">

{# ── Navigation ── #}
<nav class="navbar" id="home">
    <div class="navbar-inner">
        <a href="{{ path('home') }}" class="navbar-brand">
            <div class="brand-icon customizable-logo">
                <img src="{{ asset('images/LGO.svg') }}" alt="Ejercito's Sunscape Resort logo">
            </div>
            <span class="brand-text">Ejercito's Sunscape Resort</span>
        </a>

        <ul class="navbar-links" id="mainNavigation">
            <li class="mobile-menu-header">
                <a href="{{ path('home') }}" class="mobile-menu-brand">
                    <img src="{{ asset('images/LGO.svg') }}" alt="Ejercito's Sunscape Resort logo">
                    <span>Ejercito's Sunscape Resort</span>
                </a>
                <button class="mobile-menu-close" id="mobileMenuClose" aria-label="Close menu" type="button">
                    <span></span><span></span><span></span>
                </button>
            </li>
            <li><a href="{{ path('home') }}" class="{{ app.current_route == 'home' ? 'active' : '' }}">Home</a></li>
            <li><a href="{{ path('room_index') }}" class="{{ app.current_route starts with 'room' ? 'active' : '' }}">Rooms</a></li>
            <li><a href="{{ path('booking_index') }}" class="{{ app.current_route starts with 'booking' ? 'active' : '' }}">Booking</a></li>
            <li><a href="{{ path('dining_index') }}" class="{{ app.current_route starts with 'dining' ? 'active' : '' }}">Dining</a></li>
            <li><a href="{{ path('experience_index') }}" class="{{ app.current_route starts with 'experience' ? 'active' : '' }}">Experiences</a></li>
            <li><a href="{{ path('contact_index') }}" class="{{ app.current_route starts with 'contact' ? 'active' : '' }}">Contact</a></li>
            <li class="navbar-mobile-account">
                {% if app.user %}
                    <a href="{{ path('account_index') }}">My Account</a>
                {% else %}
                    <a href="{{ path('app_login') }}">Login</a>
                {% endif %}
            </li>
        </ul>

        <a href="{{ path('booking_index') }}" class="btn-book-now">Book Now</a>

        {% if app.user %}
            <a href="{{ path('account_index') }}" class="btn-login">My Account</a>
        {% else %}
            <a href="{{ path('app_login') }}" class="btn-login">Login</a>
        {% endif %}

        <button class="menu-toggle" id="menuToggle" aria-label="Open menu" aria-controls="mainNavigation" aria-expanded="false" type="button">
            <span></span><span></span><span></span>
        </button>
    </div>
</nav>
<div class="mobile-menu-backdrop" id="mobileMenuBackdrop" aria-hidden="true"></div>

{# ── Page content ── #}
{% block body %}{% endblock %}

{# ── Footer ── #}
<footer class="footer" id="contact">
    <div class="container">
        <div class="footer-grid">

            {# Brand column #}
            <div class="footer-brand-block">
                <div class="footer-brand-header">
                    <span class="footer-brand-icon customizable-logo">
                        <img src="{{ asset('images/LGO2.svg') }}" alt="Ejercito's Sunscape Resort logo">
                    </span>
                </div>
                <div class="footer-brand-name">Ejercito's Sunscape Resort</div>
                <p class="footer-tagline">"Where the sun meets the shore..."</p>
                <div class="footer-contact">
                    Tambisan, San Juan, Siquijor, Philippines<br>
                    +63 912 345 6789<br>
                    reservejersunscape@gmail.com
                </div>
            </div>

            {# Quick Links #}
            <div>
                <h4 class="footer-heading">Quick Links</h4>
                <ul class="footer-links">
                    <li><a href="{{ path('home') }}">Home</a></li>
                    <li><a href="{{ path('room_index') }}">Rooms &amp; Suites</a></li>
                    <li><a href="{{ path('booking_index') }}">Make a Booking</a></li>
                    <li><a href="{{ path('dining_index') }}">Dining &amp; Cuisines</a></li>
                    <li><a href="{{ path('experience_index') }}">Experiences</a></li>
                    <li><a href="{{ path('contact_index') }}">Contact Us</a></li>
                    <li><a href="{{ path('admin_login') }}">Staff Login</a></li>
                </ul>
            </div>

            {# Social #}
            <div>
                <h4 class="footer-heading">Follow Us</h4>
                <ul class="footer-social">
                    <li>
                        <span class="social-icon">
                            <svg viewBox="0 0 24 24"><path d="M22 12c0-5.52-4.48-10-10-10S2 6.48 2 12c0 4.84 3.44 8.87 8 9.8V15H8v-3h2V9.5C10 7.57 11.57 6 13.5 6H16v3h-2c-.55 0-1 .45-1 1v2h3v3h-3v6.95c5.05-.5 9-4.76 9-9.95z"/></svg>
                        </span>
                        <a href="#">Ejercito Sunscape Resort</a>
                    </li>
                    <li>
                        <span class="social-icon">
                            <svg viewBox="0 0 24 24"><path d="M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2m-.2 2A3.6 3.6 0 0 0 4 7.6v8.8C4 18.39 5.61 20 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6C20 5.61 18.39 4 16.4 4H7.6m9.65 1.5a1.25 1.25 0 0 1 1.25 1.25A1.25 1.25 0 0 1 17.25 8 1.25 1.25 0 0 1 16 6.75a1.25 1.25 0 0 1 1.25-1.25M12 7a5 5 0 0 1 5 5 5 5 0 0 1-5 5 5 5 0 0 1-5-5 5 5 0 0 1 5-5m0 2a3 3 0 0 0-3 3 3 3 0 0 0 3 3 3 3 0 0 0 3-3 3 3 0 0 0-3-3z"/></svg>
                        </span>
                        <a href="#">@ejercitosunscape</a>
                    </li>
                    <li>
                        <span class="social-icon">
                            <svg viewBox="0 0 24 24"><path d="M16.6 5.82s.51.5 0 0A4.278 4.278 0 0 1 15.54 3h-3.09v12.4a2.592 2.592 0 0 1-2.59 2.5c-1.42 0-2.6-1.16-2.6-2.6 0-1.72 1.66-3.01 3.37-2.48V9.66c-3.45-.46-6.47 2.22-6.47 5.64 0 3.33 2.76 5.7 5.69 5.7 3.14 0 5.69-2.55 5.69-5.7V9.01a7.35 7.35 0 0 0 4.3 1.38V7.3s-1.88.09-3.24-1.48z"/></svg>
                        </span>
                        <a href="#">@sunscaperesort</a>
                    </li>
                </ul>
            </div>
        </div>

        <div class="footer-bottom">
            <p>&copy; {{ "now"|date("Y") }} Ejercito's Sunscape Resort. All rights reserved.</p>
            <p class="footer-admin-link">
                <a href="{{ path('admin_login') }}" title="Staff &amp; Management Login">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: -1px; margin-right: 4px;"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                    Staff &amp; Management Portal
                </a>
            </p>
        </div>
    </div>
</footer>

</body>
</html>
